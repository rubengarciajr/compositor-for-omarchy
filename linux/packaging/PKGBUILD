# Maintainer: Compositor Contributors
# Local build from this checkout (run `makepkg -si` in linux/packaging). The AUR / release
# package that installs a prebuilt tarball is generated by scripts/release.sh from PKGBUILD.release.
pkgname=compositor-for-omarchy
pkgver=1.1.0
pkgrel=1
pkgdesc="Photoshop-style image editor with layers, themed by Omarchy (Linux port of Compositor)"
provides=(compositor)
conflicts=(compositor)
replaces=(compositor)
arch=(any)
url="https://github.com/rubengarciajr/compositor-for-omarchy"
license=(MIT)
# The app draws in a Chromium app window. Open-source Chromium is preferred; the launcher
# falls back to any Chromium-based browser that is installed (Chrome, Brave, Edge, Vivaldi,
# Flatpaks) and explains what to install when none is found.
depends=(bash)
optdepends=(
  'chromium: renderer (recommended, open source, no Google services)'
  'google-chrome: renderer fallback'
  'brave-bin: renderer fallback'
  'uwsm: launch inside the Omarchy/uwsm session like other web apps'
  'libnotify: desktop notification when no renderer is installed'
)
makedepends=(nodejs npm)
optdepends+=('librsvg: PNG launcher icons at 48/128/256 px')
source=()
# Local PKGBUILD: builds the linux/ tree next to this file (run `makepkg -si` inside linux/packaging).
# For a remote package, switch `source` to a git tag tarball and `cd "$srcdir/Compositor-$pkgver/linux"`.

build() {
  cd "$startdir/.."
  # Dev-only palette copies must not be baked into the package; the launcher supplies the live one.
  rm -f public/omarchy-theme.json public/colors.toml
  npm install
  npm run build
}

package() {
  cd "$startdir/.."
  install -d "$pkgdir/usr/share/compositor"
  # Not cp -a: a checkout with 0600/0700 files would install a dist/ that nobody but root can read.
  cp -r dist "$pkgdir/usr/share/compositor/"
  chmod -R u=rwX,go=rX "$pkgdir/usr/share/compositor"
  install -Dm755 scripts/compositor "$pkgdir/usr/bin/compositor"
  install -Dm644 packaging/compositor.desktop "$pkgdir/usr/share/applications/compositor.desktop"
  install -Dm644 public/icon.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/compositor.svg"
  for size in 48 128 256; do
    if command -v rsvg-convert >/dev/null 2>&1; then
      rsvg-convert -w "$size" -h "$size" public/icon.svg -o "$srcdir/icon-$size.png" &&
        install -Dm644 "$srcdir/icon-$size.png" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/compositor.png"
    fi
  done
  install -Dm644 packaging/compositor-project.xml "$pkgdir/usr/share/mime/packages/compositor-project.xml"
  install -Dm644 "$startdir/../../LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
