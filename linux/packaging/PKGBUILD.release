# Maintainer: Compositor Contributors
# Generated by scripts/release.sh — installs the prebuilt release tarball (no Node needed).
pkgname=compositor-for-omarchy
pkgver=@VERSION@
pkgrel=1
pkgdesc="Photoshop-style image editor with layers, themed by Omarchy (Linux port of Compositor)"
arch=(any)
url="@PROJECT_URL@"
license=(MIT)
# The app draws in a Chromium app window. Open-source Chromium is preferred; the launcher
# falls back to any Chromium-based browser that is installed and explains what to install
# when none is found.
depends=(bash)
optdepends=(
  'chromium: renderer (recommended, open source, no Google services)'
  'google-chrome: renderer fallback'
  'brave-bin: renderer fallback'
  'uwsm: launch inside the Omarchy/uwsm session like other web apps'
  'libnotify: desktop notification when no renderer is installed'
)
provides=(compositor)
conflicts=(compositor)
replaces=(compositor)
source=("$pkgname-$pkgver.tar.gz::@PROJECT_URL@/releases/download/linux-v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('@SHA256@')

package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -d "$pkgdir/usr/share/compositor"
  cp -r dist "$pkgdir/usr/share/compositor/"
  chmod -R u=rwX,go=rX "$pkgdir/usr/share/compositor"
  install -Dm755 bin/compositor "$pkgdir/usr/bin/compositor"
  install -Dm644 share/compositor.desktop "$pkgdir/usr/share/applications/compositor.desktop"
  install -Dm644 share/compositor-project.xml "$pkgdir/usr/share/mime/packages/compositor-project.xml"
  install -Dm644 share/icons/compositor.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/compositor.svg"
  for size in 48 128 256; do
    install -Dm644 "share/icons/compositor-$size.png" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/compositor.png"
  done
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  for d in docs/*.md; do install -Dm644 "$d" "$pkgdir/usr/share/doc/$pkgname/$(basename "$d")"; done
}
